import os
import numpy as np
import rasterio
import shap
from xgboost import XGBRegressor
from skopt import BayesSearchCV
from sklearn.model_selection import GroupKFold
from sklearn.metrics import r2_score, mean_squared_error, mean_absolute_error

target_file = "target.tif"
driver_files = ["driver1.tif", "driver2.tif", "driver3.tif"]

BLOCK_SIZE = 10
N_SPLITS = 5
N_BAYES_ITER = 50
RANDOM_STATE = 42

def read_raster(path):
    with rasterio.open(path) as src:
        return src.read(1, masked=True).filled(np.nan).astype(np.float32)

y_grid = read_raster(target_file)
X_stack = np.stack([read_raster(f) for f in driver_files], axis=-1)

mask = np.isfinite(y_grid) & np.all(np.isfinite(X_stack), axis=-1)
X, y = X_stack[mask], y_grid[mask]

rows, cols = np.where(mask)
n_block_cols = int(np.ceil(mask.shape[1] / BLOCK_SIZE))
groups = (rows // BLOCK_SIZE) * n_block_cols + (cols // BLOCK_SIZE)

cv = GroupKFold(n_splits=N_SPLITS)

model = XGBRegressor(
    objective="reg:squarederror",
    random_state=RANDOM_STATE,
    tree_method="hist"
)

# Define hyperparameter ranges according to the analysis
param_space = {
    "n_estimators": (...),
    "max_depth": (...),
    "learning_rate": (...),
    "subsample": (...),
    "colsample_bytree": (...),
    "min_child_weight": (...),
    "gamma": (...),
    "reg_alpha": (...),
    "reg_lambda": (...)
}

optimizer = BayesSearchCV(
    model,
    param_space,
    n_iter=N_BAYES_ITER,
    cv=cv,
    scoring="r2",
    random_state=RANDOM_STATE,
    n_jobs=-1
)

optimizer.fit(X, y, groups=groups)
best_params = optimizer.best_params_

r2, rmse, mae = [], [], []

for train, test in cv.split(X, y, groups):
    model = XGBRegressor(
        objective="reg:squarederror",
        random_state=RANDOM_STATE,
        tree_method="hist",
        **best_params
    )
    model.fit(X[train], y[train])
    pred = model.predict(X[test])

    r2.append(r2_score(y[test], pred))
    rmse.append(np.sqrt(mean_squared_error(y[test], pred)))
    mae.append(mean_absolute_error(y[test], pred))

print("R2:", np.mean(r2))
print("RMSE:", np.mean(rmse))
print("MAE:", np.mean(mae))

final_model = XGBRegressor(
    objective="reg:squarederror",
    random_state=RANDOM_STATE,
    tree_method="hist",
    **best_params
)
final_model.fit(X, y)

shap_values = shap.TreeExplainer(final_model).shap_values(X)
importance = np.mean(np.abs(shap_values), axis=0)

for f, v in sorted(zip(driver_files, importance), key=lambda x: x[1], reverse=True):
    print(f, v)
