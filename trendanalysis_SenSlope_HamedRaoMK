import os
import numpy as np
import rasterio
import pymannkendall as mk
from tqdm import tqdm

# ============================================================
# User settings
# ============================================================
input_folder = "input_folder"
output_folder = "output_folder"

VARIABLE_PREFIX = "Topt_observed_significant"
VARIABLE_NAME = "Topt"

WINDOW_LENGTH = 17
START_YEAR = 1983
LAST_START_YEAR = 2006

ALPHA = 0.05

os.makedirs(output_folder, exist_ok=True)


# ============================================================
# Read raster and convert NoData to NaN
# ============================================================
def read_tif(path):
    with rasterio.open(path) as src:
        return (
            src.read(1, masked=True)
            .filled(np.nan)
            .astype(np.float32)
        )


# ============================================================
# Pixel-wise Theil-Sen slope + Hamed-Rao modified MK test
#
# IMPORTANT:
# Trend analysis is performed only for pixels with a complete
# sequence of moving-window estimates. Missing windows are not
# removed before trend calculation.
# ============================================================
def trend_analysis(data_stack):
    n_windows, nrows, ncols = data_stack.shape

    slope_array = np.full(
        (nrows, ncols),
        np.nan,
        dtype=np.float32
    )

    pvalue_array = np.full(
        (nrows, ncols),
        np.nan,
        dtype=np.float32
    )

    for i in tqdm(range(nrows), desc="Trend analysis"):
        for j in range(ncols):

            # Retain the original chronological sequence
            y = data_stack[:, i, j]

            # Require all moving-window estimates to be valid.
            # For the 17-year analysis this corresponds to 24/24
            # windows; for the 21-year analysis it corresponds
            # to 20/20 windows.
            if not np.all(np.isfinite(y)):
                continue

            try:
                result = mk.hamed_rao_modification_test(
                    y,
                    alpha=ALPHA
                )

                slope_array[i, j] = result.slope
                pvalue_array[i, j] = result.p

            except Exception:
                # Leave slope and p value as NaN if the
                # Hamed-Rao calculation cannot be completed.
                continue

    return slope_array, pvalue_array


# ============================================================
# Save raster
# ============================================================
def save_tif(path, data, profile):
    nodata = -9999.0

    output_profile = profile.copy()
    output_profile.update(
        driver="GTiff",
        dtype="float32",
        count=1,
        nodata=nodata,
        compress="lzw"
    )

    output_data = np.where(
        np.isfinite(data),
        data,
        nodata
    ).astype(np.float32)

    with rasterio.open(path, "w", **output_profile) as dst:
        dst.write(output_data, 1)


# ============================================================
# Main workflow
# ============================================================
if __name__ == "__main__":

    # Generate moving-window raster list in chronological order
    tif_list = [
        os.path.join(
            input_folder,
            f"{VARIABLE_PREFIX}_{year}_"
            f"{year + WINDOW_LENGTH - 1}.tif"
        )
        for year in range(
            START_YEAR,
            LAST_START_YEAR + 1
        )
    ]

    # Corresponding moving-window start years
    window_years = np.arange(
        START_YEAR,
        LAST_START_YEAR + 1
    )

    # Check input files
    missing_files = [
        path for path in tif_list
        if not os.path.exists(path)
    ]

    if missing_files:
        raise FileNotFoundError(
            f"{len(missing_files)} input raster(s) are missing."
        )

    print(f"Number of moving windows: {len(tif_list)}")
    print(
        f"Window sequence: "
        f"{START_YEAR}-{START_YEAR + WINDOW_LENGTH - 1} "
        f"to "
        f"{LAST_START_YEAR}-{LAST_START_YEAR + WINDOW_LENGTH - 1}"
    )
    print(
        f"Complete-window criterion: "
        f"{len(tif_list)}/{len(tif_list)} valid windows required."
    )

    # Read raster metadata
    with rasterio.open(tif_list[0]) as src:
        profile = src.profile.copy()
        height = src.height
        width = src.width

    # Load moving-window rasters
    data_stack = np.full(
        (len(tif_list), height, width),
        np.nan,
        dtype=np.float32
    )

    for i, path in enumerate(
        tqdm(tif_list, desc="Reading rasters")
    ):
        data_stack[i] = read_tif(path)

    # --------------------------------------------------------
    # Diagnostic: complete-window mask
    # --------------------------------------------------------
    complete_mask = np.all(
        np.isfinite(data_stack),
        axis=0
    )

    print(
        "Pixels with complete moving-window sequences:",
        int(np.sum(complete_mask))
    )

    # Trend analysis
    sen_slope, modified_mk_p = trend_analysis(
        data_stack
    )

    # Save Theil-Sen slope
    save_tif(
        os.path.join(
            output_folder,
            f"{VARIABLE_NAME}_SenSlope_"
            f"{WINDOW_LENGTH}yr.tif"
        ),
        sen_slope,
        profile
    )

    # Save Hamed-Rao modified MK p-value
    save_tif(
        os.path.join(
            output_folder,
            f"{VARIABLE_NAME}_HamedRaoMK_Pvalue_"
            f"{WINDOW_LENGTH}yr.tif"
        ),
        modified_mk_p,
        profile
    )

    print("Trend analysis completed.")
