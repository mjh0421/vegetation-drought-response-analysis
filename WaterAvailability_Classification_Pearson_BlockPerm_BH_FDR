import numpy as np
from scipy.stats import pearsonr


def bh_fdr(p_values, alpha=0.05):
    p_values = np.asarray(p_values, float)

    valid = np.isfinite(p_values)
    reject = np.zeros(p_values.shape, dtype=bool)

    p = p_values[valid]
    if len(p) == 0:
        return reject

    order = np.argsort(p)
    p_sorted = p[order]
    m = len(p_sorted)

    passed = (
        p_sorted
        <= alpha * np.arange(1, m + 1) / m
    )

    if np.any(passed):
        threshold = p_sorted[np.where(passed)[0].max()]
        reject[valid] = p <= threshold

    return reject


def make_block_permutations(
    n_years=40,
    block_size=2,
    n_perm=999,
    seed=20260714
):
    rng = np.random.default_rng(seed)

    blocks = np.arange(n_years).reshape(
        -1, block_size
    )

    return np.stack([
        blocks[
            rng.permutation(len(blocks))
        ].ravel()
        for _ in range(n_perm)
    ])


def correlation_test(x, y, permutations, min_n=10):
    valid = np.isfinite(x) & np.isfinite(y)

    if (
        valid.sum() < min_n
        or np.std(x[valid]) == 0
        or np.std(y[valid]) == 0
    ):
        return np.nan, np.nan, np.nan

    x = x[valid]
    y = y[valid]

    r, p_pearson = pearsonr(x, y)

    # complete 40-year series
    if len(x) == len(permutations[0]):
        x0 = x - x.mean()
        y0 = y - y.mean()

        sx = np.sqrt(np.sum(x0 ** 2))
        sy = np.sqrt(np.sum(y0 ** 2))

        r_perm = (
            y0[permutations] / sy
        ) @ (
            x0 / sx
        )

        p_block = (
            1
            + np.sum(
                np.abs(r_perm) >= abs(r)
            )
        ) / (
            len(permutations) + 1
        )

    else:
        p_block = np.nan

    return r, p_pearson, p_block


def classify(r_values, significant):
    n_positive = np.sum(
        significant & (r_values > 0)
    )

    n_negative = np.sum(
        significant & (r_values < 0)
    )

    if n_positive > n_negative:
        water_class = 1      # water-deficit

    elif n_negative > n_positive:
        water_class = -1     # water-surplus

    else:
        water_class = 0      # unclassified

    return water_class, n_positive, n_negative


def water_availability_classification(
    vegetation,
    spei,
    permutations
):
    """
    vegetation: shape (7, 40)
                April-October vegetation series

    spei: shape (24, 7, 40)
          SPEI scales 1-24 for April-October

    Returns
    -------
    Pearson,
    Pearson_BH_FDR,
    BlockPerm_BH_FDR

    Each result:
    water_class, N_positive, N_negative
    """

    r_values = []
    p_pearson = []
    p_block = []

    # 7 months × 24 SPEI scales = 168 tests
    for m in range(7):
        for s in range(24):

            r, p1, p2 = correlation_test(
                vegetation[m],
                spei[s, m],
                permutations
            )

            r_values.append(r)
            p_pearson.append(p1)
            p_block.append(p2)

    r_values = np.asarray(r_values)
    p_pearson = np.asarray(p_pearson)
    p_block = np.asarray(p_block)

    # 1. Pearson p < 0.05
    pearson = classify(
        r_values,
        np.isfinite(p_pearson)
        & (p_pearson < 0.05)
    )

    # 2. Pearson + BH-FDR
    pearson_fdr = classify(
        r_values,
        bh_fdr(p_pearson, 0.05)
    )

    # 3. Block permutation + BH-FDR
    block_fdr = classify(
        r_values,
        bh_fdr(p_block, 0.05)
    )

    return pearson, pearson_fdr, block_fdr
