import numpy as np
from scipy.stats import pearsonr


def bh_fdr(pvals, alpha=0.05):
    pvals = np.asarray(pvals, float)
    reject = np.zeros(pvals.shape, bool)

    valid = np.isfinite(pvals)
    p = pvals[valid]
    if p.size == 0:
        return reject

    ps = np.sort(p)
    passed = ps <= alpha * np.arange(1, len(ps) + 1) / len(ps)

    if np.any(passed):
        cutoff = ps[np.where(passed)[0][-1]]
        reject[valid] = p <= cutoff

    return reject


def make_block_perms(n_years, block_size=2, n_perm=999, seed=20260714):
    if n_years % block_size != 0:
        raise ValueError("n_years must be divisible by block_size.")

    rng = np.random.default_rng(seed)
    blocks = np.arange(n_years).reshape(-1, block_size)

    return np.stack([
        blocks[rng.permutation(len(blocks))].ravel()
        for _ in range(n_perm)
    ])


def block_test(x, y, perms, min_n=10):
    x = np.asarray(x, float)
    y = np.asarray(y, float)
    valid = np.isfinite(x) & np.isfinite(y)

    if valid.sum() < min_n:
        return np.nan, np.nan, np.nan

    xv, yv = x[valid], y[valid]
    if np.std(xv) == 0 or np.std(yv) == 0:
        return np.nan, np.nan, np.nan

    r, p_pearson = pearsonr(xv, yv)

    # Fast path for complete annual series
    if np.all(valid):
        x0 = x - x.mean()
        y0 = y - y.mean()

        rp = (
            y0[perms] / np.sqrt(np.sum(y0 ** 2))
        ) @ (
            x0 / np.sqrt(np.sum(x0 ** 2))
        )

        p_block = (
            1 + np.sum(np.abs(rp) >= abs(r))
        ) / (len(perms) + 1)

        return r, p_pearson, p_block

    # Fallback for incomplete series
    extreme, n = 0, 0

    for idx in perms:
        yp = y[idx]
        v = np.isfinite(x) & np.isfinite(yp)

        if v.sum() < min_n:
            continue
        if np.std(x[v]) == 0 or np.std(yp[v]) == 0:
            continue

        rp = pearsonr(x[v], yp[v])[0]
        n += 1
        extreme += abs(rp) >= abs(r)

    p_block = (1 + extreme) / (n + 1) if n else np.nan

    return r, p_pearson, p_block


def classify(rs, significant):
    n_pos = np.sum(significant & (rs > 0))
    n_neg = np.sum(significant & (rs < 0))

    if n_pos > n_neg:
        return 1       # water-deficit
    if n_neg > n_pos:
        return -1      # water-surplus
    return 0           # unclassified


def classify_pixel(veg, spei_list, perms, p=0.05, fdr=0.05, min_n=10):
    """
    veg shape:
        [7 months, years]

    spei_list:
        24 arrays, each [7 months, years]

    7 months × 24 SPEI scales = 168 tests
    """

    rs, p_pearson, p_block = [], [], []

    for month in range(veg.shape[0]):
        for spei in spei_list:

            r, pp, pb = block_test(
                veg[month],
                spei[month],
                perms,
                min_n
            )

            rs.append(r)
            p_pearson.append(pp)
            p_block.append(pb)

    rs = np.asarray(rs)
    p_pearson = np.asarray(p_pearson)
    p_block = np.asarray(p_block)

    return {
        "pearson": classify(
            rs,
            np.isfinite(p_pearson) & (p_pearson < p)
        ),

        "pearson_fdr": classify(
            rs,
            bh_fdr(p_pearson, fdr)
        ),

        "block_fdr": classify(
            rs,
            bh_fdr(p_block, fdr)
        )
    }
